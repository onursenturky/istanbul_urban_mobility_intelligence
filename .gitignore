.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# osmnx's internal HTTP response cache (not a project data artifact —
# the real raw artifact is data/raw/boundaries/*.geojson)
/cache/

# Raw data is fetched by scripts, not committed (large, re-fetchable, cached locally)
data/raw/*/
!data/raw/*/.gitkeep

# Processed outputs are regenerated by pipeline scripts
data/processed/*
!data/processed/features/
data/processed/features/*
!data/processed/features/.gitkeep

outputs/maps/*
outputs/figures/*
outputs/models/*
!outputs/maps/.gitkeep
!outputs/figures/.gitkeep
!outputs/models/.gitkeep
